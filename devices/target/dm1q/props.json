{
  "version": 2,
  "rules": [
    {
      "name": "prop_set",
      "priority": 20,
      "enabled": true,
      "description": "Ajuste de alvos de partição para Base Samsung",
      "config": {
        "properties": [
          {
            "key": "ro.sf.lcd_density",
            "source": "base_lcd_density",
            "target_partition": "product"
          },
          {
            "key": "ro.product.first_api_level",
            "value": "33",
            "target_partition": "product"
          }
        ]
      }
    }
  ]
}